# ==============================================================================
# CampusHub — Environment Variables Template
# Copy to .env.local and fill in real values. NEVER commit .env.local to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CampusHub"
DEFAULT_TIMEZONE="Asia/Kolkata"
USE_MOCK="true"
CRON_SECRET="your-cron-secret-for-auto-expiry"

# ------------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Ensure the PostGIS extension is enabled in your DB: CREATE EXTENSION postgis;
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://campushub_user:your_password@localhost:5432/campushub_db?schema=public"
DIRECT_URL="postgresql://campushub_user:your_password@localhost:5432/campushub_db?schema=public"

# ------------------------------------------------------------------------------
# NextAuth.js v5 (Auth.js)
# Generate AUTH_SECRET: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET="your-super-secret-auth-secret-minimum-32-chars"
AUTH_URL="http://localhost:3000"

# Allowed college email domain (e.g. @campus.edu or @nitw.ac.in)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="@campus.edu"

# Google OAuth (optional SSO via institutional Google Workspace)
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Microsoft Entra / Azure AD SSO (optional)
AUTH_MICROSOFT_ENTRA_ID_ID="your-azure-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-azure-client-secret"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/your-tenant-id/v2.0"

# ------------------------------------------------------------------------------
# Firebase (Cloud Messaging — Push Notifications)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abc123"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-fcm-vapid-public-key"

# Firebase Admin SDK (server-side FCM sends)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}' # JSON stringified

# ------------------------------------------------------------------------------
# Map Configuration (Leaflet / OpenStreetMap)
# ------------------------------------------------------------------------------
# Default campus centre coordinates (lat, lng)
NEXT_PUBLIC_MAP_DEFAULT_LAT="17.4065"
NEXT_PUBLIC_MAP_DEFAULT_LNG="78.4772"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM="16"
NEXT_PUBLIC_MAP_MIN_ZOOM="14"
NEXT_PUBLIC_MAP_MAX_ZOOM="22"

# Optional: Mapbox token for premium tiles (leave blank to use OSM)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# File Uploads — UploadThing
# ------------------------------------------------------------------------------
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# OR — AWS S3 Presigned URLs (alternative to UploadThing)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET_NAME="campushub-uploads"

# ------------------------------------------------------------------------------
# Redis (optional: for rate limiting, session caching, real-time pub/sub)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ------------------------------------------------------------------------------
# Email (for notifications and OTP verification)
# ------------------------------------------------------------------------------
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="noreply@campus.edu"
EMAIL_SERVER_PASSWORD="your-smtp-app-password"
EMAIL_FROM="CampusHub <noreply@campus.edu>"

# ------------------------------------------------------------------------------
# PWA / Service Worker
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SW_UPDATE_INTERVAL_MS="60000"
